{
  "compilerOptions": {
    "target": "ES2024",
    "allowJs": true,
    "skipLibCheck": true,
    "outDir": "./dist",  
    "strict": true,
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true, 
    "sourceMap": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "./src", 
    "rootDir": "./src",
    "plugins": [],
    "paths": {
      "@racetrack/*": ["./src/*"],
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
